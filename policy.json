    "rights": {
        "commercial": "contract",
        "openSourceRequired": false,
        "caching": {
            "permission": "unknown",
            "maxTtl": null
        },
        "storage": "unknown",
        "redistribution": "unknown",
        "attribution": {
            "required": false,
            "text": null,
            "url": null,
            "where": []
        },
        "licence": null
    },
    "requirements": {
        "key": true,
        "userAgent": {
            "required": false,
            "pattern": null
        }
    },
    "provenance": {
        "terms": "https://www.firecrawl.dev/terms-of-service",
        "policy": "https://docs.firecrawl.dev/rate-limits",
        "verifiedAt": "2026-11-10",
        "declaredBy": "maintainer",
        "contact": "https://www.firecrawl.dev",
        "notes": "Terms revised 2026-10-07. §5.d.1 forbids use for commercial purposes except as expressly authorized by Firecrawl: declared \"contract\" (a paid plan's agreement is that authorization; check yours). §7.g: use only in compliance with all applicable laws and regulations; the customer indemnifies Firecrawl and accepts all risks associated with third parties and their content - the legality of collecting a site stays the site's operator's, which is why omnicrawl's gate decides before Firecrawl is called. The terms say nothing of robots.txt or of keeping results. Limits are per team and per plan (https://docs.firecrawl.dev/rate-limits): this policy's figures are the free plan's, the default; plans declares hobby, standard, growth and scale, picked with the factory's \"plan\" option; a 429 covers rate and concurrency, with Retry-After when available. Firecrawl checks robots.txt itself for the token FirecrawlAgent and * before crawling, which the family does not rely on. Not used: proxy \"enhanced\"/\"auto\" (anti-bot proxies), actions, location, mobile."
    }
