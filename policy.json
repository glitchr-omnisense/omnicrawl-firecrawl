                            "fetch"
                        ],
                        "note": "/scrape, per team"
                    },
                    {
                        "max": 2,
                        "window": "minute",
                        "operations": [
                            "start"
                        ],
                        "note": "/crawl, which batch scrape shares"
                    }
                ],
                "concurrency": 2,
                "source": "https://docs.firecrawl.dev/rate-limits",
                "verifiedAt": "2026-11-10"
            },
            "hobby": {
                "rateLimits": [
                    {
                        "max": 100,
                        "window": "minute",
                        "operations": [
                            "fetch"
                        ],
                        "note": "/scrape, per team"
                    },
                    {
                        "max": 20,
                        "window": "minute",
                        "operations": [
                            "start"
                        ],
                        "note": "/crawl, which batch scrape shares"
