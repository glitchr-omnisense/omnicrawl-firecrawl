{
    "$schema": "https://github.com/glitchr-omnisense/contracts/blob/1.x/resources/usage-policy.schema.json",
    "provider": "firecrawl",
    "rateLimits": [
        {
            "max": 10,
            "window": "minute",
            "operations": [
                "fetch"
            ],
            "note": "/scrape, per team: the free plan's figure, the default; the \"plan\" option picks another (plans)."
        },
        {
            "max": 2,
            "window": "minute",
            "operations": [
                "start"
            ],
            "note": "Free plan: /crawl 2 requests a minute per team, which batch scrape shares; counted on starting a run (the status reads are not in the published table read on that day)."
        }
    ],
    "concurrency": 2,
    "plans": {
        "default": "free",
        "plans": {
            "free": {
                "rateLimits": [
                    {
                        "max": 10,
                        "window": "minute",
