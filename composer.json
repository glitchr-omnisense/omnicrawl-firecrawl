{
    "name": "omnicrawl/firecrawl",
    "type": "library",
    "description": "Omnicrawl's Firecrawl (API v2), under any PHP host: pages fetched as raw HTML and batch runs over a fixed set of addresses, behind omnicrawl's gate (robots.txt, the target's declaration, per-host limits, provenance) - the family's User-Agent sent to the target, the basic proxy only (never Firecrawl's anti-bot proxies), no cache left at Firecrawl; Firecrawl always renders, so undeclared sites are refused. Its limits and terms declared as data.",
    "keywords": [
        "firecrawl",
        "scraping",
        "batch-scrape",
        "omnicrawl",
        "responsible",
        "framework-agnostic"
    ],
    "homepage": "https://github.com/glitchr-omnisense/omnicrawl-firecrawl",
    "license": "MIT",
    "authors": [
        {
            "name": "Marco Meyer",
            "email": "marco.meyer@glitchr.io"
        }
    ],
    "require": {
        "php": ">=8.2",
        "omnisense/contracts": "^1.0@dev",
        "omnisense/omnicrawl": "^1.0@dev",
        "symfony/http-client": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Omnicrawl\\Firecrawl\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Omnicrawl\\Firecrawl\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "omnisense": {
            "policy": "policy.json"
        },
        "branch-alias": {
            "dev-1.x": "1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    }
}
